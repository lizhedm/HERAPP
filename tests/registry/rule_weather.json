 {
  "id": "SYS-RULE-002",
  "title": "天气综合分与封面综合关系分对同一组分数互不影响",
  "req": [
   "REQ-16-14"
  ],
  "reqSection": [
   "7.1",
   "5.1"
  ],
  "screens": [],
  "layer": "rule",
  "priority": "P0",
  "given": [
   "总分 88、情绪分 82、亲密度 90、沟通比 85"
  ],
  "when": [
   "分别计算天气综合分与封面综合关系分"
  ],
  "then": [
   "天气综合分为 86",
   "封面综合关系分为 87，由 亲密度×0.6 + 情绪分×0.4 得出",
   "两套权重各自独立，任一权重变更不影响另一套的结果",
   "沟通比只进入天气综合分，不进入封面综合关系分"
  ],
  "oracle": {
   "fn": "cover_score",
   "cases": [
    {
     "args": [
      90,
      82
     ],
     "expect": 87
    },
    {
     "args": [
      100,
      0
     ],
     "expect": 60
    },
    {
     "args": [
      0,
      100
     ],
     "expect": 40
    }
   ]
  },
  "testId": "packages/ling_core/test/composite_isolation_test.dart::双综合分独立"
 },
