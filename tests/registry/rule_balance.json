   "计算该维度的对等度"
  ],
  "then": [
   "结果等于 2×min(甲,乙)÷(甲+乙)×100 四舍五入取整",
   "两值相等得 100，一方为 0 得 0",
   "两值同时为 0 表示该维度双方都未发生，按完全对等得 100",
   "交换甲乙两值结果不变"
  ],
  "oracle": {
   "fn": "balance_ratio",
   "cases": [
    {
     "args": [
      5,
      5
     ],
     "expect": 100
    },
    {
     "args": [
      0,
      0
     ],
     "expect": 100
    },
    {
     "args": [
      10,
      0
     ],
     "expect": 0
    },
    {
     "args": [
      0,
      10
     ],
     "expect": 0
    },
    {
     "args": [
      3,
      7
     ],
     "expect": 60
    },
    {
     "args": [
      7,
      3
     ],
     "expect": 60
    },
    {
     "args": [
      1,
      2
     ],
     "expect": 67
    },
    {
     "args": [
      120,
      80
     ],
     "expect": 80
    }
   ]
  },
  "testId": "packages/ling_core/test/balance_test.dart::单项对等度对称性"
 },
