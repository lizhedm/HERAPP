      [
       5
      ]
     ],
     "expect": 1
    },
    {
     "args": [
      [
       0,
       600,
       1200,
       3000,
       3001,
       5000
      ]
     ],
     "expect": 5
    },
    {
     "args": [
      [
       5000,
       3001,
       3000,
       1200,
       600,
       0
      ]
     ],
     "expect": 5
    },
    {
     "args": [
      [
       0,
       2000,
       4000,
       6000
      ]
     ],
     "expect": 1
    }
   ]
  },
  "testId": "packages/ling_core/test/stats_test.dart::最长连续对话"
