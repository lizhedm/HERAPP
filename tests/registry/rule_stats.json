 {
  "id": "SYS-RULE-043",
  "title": "周期键按 ISO 8601 计算，周一为周首且跨年周归属正确",
  "req": [
   "REQ-16-18"
  ],
  "reqSection": [
   "9.2"
  ],
  "screens": [
   "E1",
   "E2"
  ],
  "layer": "rule",
  "priority": "P0",
  "given": [
   "一个日期与周、月、年三种粒度"
  ],
  "when": [
   "计算周期键"
  ],
  "then": [
   "周粒度返回 ISO 年与 ISO 周号，周一为周首",
   "跨年边界的日期归入 ISO 日历所属的那一周，年份取 ISO 年",
   "月粒度返回年-月，年粒度返回年"
  ],
  "oracle": {
   "fn": "period_key",
   "cases": [
    {
     "args": [
      "2026-11-24",
      "WEEK"
     ],
     "expect": "2026-W48"
    },
    {
     "args": [
      "2026-01-01",
      "WEEK"
     ],
     "expect": "2026-W01"
    },
    {
     "args": [
      "2026-12-31",
      "WEEK"
     ],
     "expect": "2026-W53"
    },
    {
     "args": [
      "2026-11-24",
      "MONTH"
     ],
     "expect": "2026-11"
    },
    {
     "args": [
      "2026-11-24",
      "YEAR"
     ],
     "expect": "2026"
    }
   ]
  },
  "testId": "packages/ling_core/test/stats_test.dart::周期键计算"
 },
 {
