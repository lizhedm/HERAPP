[
 {
  "id": "SYS-RULE-040",
  "title": "字数口径为 TEXT 类型内容的 Unicode 码点数且不含首尾空白",
  "req": [
   "REQ-16-12"
  ],
  "reqSection": [
   "6.1"
  ],
  "screens": [
   "D2"
  ],
  "layer": "rule",
  "priority": "P0",
  "given": [
   "一条消息的文本内容"
  ],
  "when": [
   "计算字数"
  ],
  "then": [
   "按 Unicode 码点计数，中英文混排各计 1",
   "首尾空白不计入，内部空白计入",
   "空串与纯空白串计 0",
   "TEXT 以外的消息类型字数计 0，条数照常计入"
  ],
  "oracle": {
   "fn": "text_length",
   "cases": [
    {
     "args": [
      "  hello 世界  "
     ],
     "expect": 8
    },
    {
     "args": [
      ""
     ],
     "expect": 0
    },
    {
     "args": [
      "   "
     ],
     "expect": 0
    },
    {
     "args": [
      "你好"
     ],
     "expect": 2
    },
    {
     "args": [
      "a b"
     ],
     "expect": 3
    }
   ]
  },
  "testId": "packages/ling_core/test/stats_test.dart::字数口径"
 },
 {
  "id": "SYS-RULE-041",
  "title": "连续对话段按 30 分钟间隔切分，恰好 30 分钟归入同一段",
  "req": [
   "REQ-16-12"
  ],
  "reqSection": [
   "6.1"
  ],
  "screens": [
   "D2"
  ],
  "layer": "rule",
  "priority": "P0",
  "given": [
   "一组按时区换算后的消息时间戳，单位为秒"
  ],
  "when": [
   "计算连续对话段数"
  ],
  "then": [
   "相邻两条消息间隔超过 30 分钟视为新段",
   "间隔恰为 1800 秒归入同一段，1801 秒切出新段",
   "消息数为 0 时段数为 0，单条消息段数为 1"
  ],
  "oracle": {
   "fn": "segment_count",
   "cases": [
    {
     "args": [
      []
     ],
     "expect": 0
    },
    {
     "args": [
      [
       5
      ]
     ],
     "expect": 1
    },
    {
     "args": [
      [
       0,
       1800
      ]
     ],
     "expect": 1
    },
    {
     "args": [
      [
       0,
       1801
      ]
     ],
     "expect": 2
    },
    {
     "args": [
      [
       0,
       600,
       1200,
       3000,
       3001,
       5000
      ]
     ],
     "expect": 2
    },
    {
     "args": [
      [
       0,
       2000,
       4000,
       6000
      ]
     ],
     "expect": 4
    }
   ]
  },
  "testId": "packages/ling_core/test/stats_test.dart::对话段切分"
 },
 {
  "id": "SYS-RULE-042",
  "title": "最长连续对话条数取各段条数的最大值",
  "req": [
   "REQ-16-12"
  ],
  "reqSection": [
   "6.1"
  ],
  "screens": [
   "D2"
  ],
  "layer": "rule",
  "priority": "P1",
  "given": [
   "一组消息时间戳，含长短不一的多个对话段"
  ],
  "when": [
   "计算最长连续对话条数"
  ],
  "then": [
   "结果为条数最多的那一段的消息条数",
   "消息数为 0 时结果为 0，单条消息结果为 1",
   "时间戳乱序传入时先排序再判定，结果与有序输入一致"
  ],
  "oracle": {
   "fn": "longest_segment",
   "cases": [
    {
     "args": [
