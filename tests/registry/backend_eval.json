 {
  "id": "SYS-RULE-050",
  "title": "脱敏按固定顺序替换 6 类结构化敏感信息",
  "req": ["REQ-16-36"],
  "reqSection": ["6.5"],
  "screens": [],
  "layer": "backend",
  "priority": "P0",
  "given": ["含手机号、身份证号、银行卡号、邮箱、详细地址与验证码的文本"],
  "when": ["执行送 AI 前的脱敏"],
  "then": [
   "6 类对象各替换为对应占位符",
   "邮箱先行替换，整个邮箱作为一个整体被替换",
   "身份证先于银行卡，18 位纯数字判为身份证号",
   "身份证末位的 X 大小写均识别"
  ],
  "oracle": {
   "fn": "mask",
   "cases": [
    {"args": ["我的电话是13812345678"], "expect": "我的电话是[手机号]"},
    {"args": ["身份证11010519491231002X"], "expect": "身份证[身份证号]"},
    {"args": ["身份证11010519491231002x"], "expect": "身份证[身份证号]"},
    {"args": ["卡号6222021234567890123"], "expect": "卡号[银行卡号]"},
    {"args": ["邮箱 zhang.san+a@example.com 收"], "expect": "邮箱 [邮箱] 收"},
    {"args": ["电话13812345678 邮箱a@b.com 验证码 123456 身份证11010519491231002X"], "expect": "电话[手机号] [邮箱] 验证码 [验证码] 身份证[身份证号]"}
   ]
  },
  "testId": "backend/tests/test_mask.py::六类敏感信息替换"
 },
 {
