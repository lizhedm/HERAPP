   "输入日期乱序时结果与有序输入一致"
  ],
  "oracle": {
   "fn": "eval_queue",
   "cases": [
    {"args": [["2026-01-01", "2026-01-03", "2026-01-02"]], "expect": {"queued": ["2026-01-03", "2026-01-02", "2026-01-01"], "deferred": []}},
    {"args": [["2026-01-01", "2026-01-02", "2026-01-03"], 2], "expect": {"queued": ["2026-01-03", "2026-01-02"], "deferred": ["2026-01-01"]}},
    {"args": [[]], "expect": {"queued": [], "deferred": []}}
   ]
  },
  "testId": "backend/tests/test_queue.py::队列排序与截断"
 },
