    {"args": ["验证码：8888"], "expect": "验证码：[验证码]"},
    {"args": ["码 1234"], "expect": "码 [验证码]"},
    {"args": ["订单号1234567"], "expect": "订单号1234567"},
    {"args": ["价格 1200 元"], "expect": "价格 1200 元"},
    {"args": ["2026年"], "expect": "2026年"}
