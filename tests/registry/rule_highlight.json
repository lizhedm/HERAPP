 {
  "id": "SYS-RULE-020",
  "title": "高光触发条件为总分不低于 85 且情绪分不低于 70，或总分不低于 90",
  "req": ["REQ-16-17"],
  "reqSection": ["8.1"],
  "screens": ["G1"],
  "layer": "rule",
  "priority": "P0",
  "given": ["一组总分与情绪分"],
  "when": ["判定是否触发高光"],
  "then": [
   "总分 85、情绪分 70 触发",
   "总分 85、情绪分 69 不触发",
   "总分 84、情绪分 70 不触发",
   "总分 90、情绪分 0 由第二个条件单独触发"
  ],
  "oracle": {
   "fn": "highlight_triggered",
   "cases": [
    {"args": [85, 70], "expect": true},
    {"args": [85, 69], "expect": false},
    {"args": [84, 70], "expect": false},
    {"args": [90, 0], "expect": true},
    {"args": [89, 69], "expect": false},
    {"args": [100, 100], "expect": true}
   ]
  },
  "testId": "packages/ling_core/test/highlight_test.dart::高光触发条件"
 },
 {
  "id": "SYS-RULE-021",
  "title": "高光类型按 5 条优先级判定，前一条命中即停止",
  "req": ["REQ-16-17"],
  "reqSection": ["8.1"],
  "screens": ["G1", "G3"],
  "layer": "rule",
  "priority": "P0",
  "given": ["已触发高光的一组总分、情绪分、亲密度与有趣对话条数"],
  "when": ["判定高光类型"],
  "then": [
   "综合高光要求总分 ≥ 90 且情绪分 ≥ 85 且亲密度 ≥ 85，三项缺一即落到后续优先级",
   "高亲密要求亲密度 ≥ 90，高情绪要求情绪分 ≥ 90",
   "有趣对话要求条数 ≥ 2",
   "以上均不命中时为高总分",
   "未触发高光时不产生类型"
  ],
  "oracle": {
   "fn": "highlight_type",
   "cases": [
    {"args": [90, 85, 85, 0], "expect": "OVERALL"},
    {"args": [100, 100, 100, 0], "expect": "OVERALL"},
    {"args": [90, 84, 85, 0], "expect": "HIGH_SCORE"},
    {"args": [90, 85, 84, 0], "expect": "HIGH_SCORE"},
    {"args": [85, 70, 90, 0], "expect": "HIGH_INTIMACY"},
    {"args": [85, 90, 80, 0], "expect": "HIGH_EMOTION"},
    {"args": [85, 70, 80, 2], "expect": "FUN"},
    {"args": [85, 70, 80, 1], "expect": "HIGH_SCORE"},
    {"args": [90, 0, 0, 0], "expect": "HIGH_SCORE"},
    {"args": [89, 69, 50, 5], "expect": null}
   ]
  },
  "testId": "packages/ling_core/test/highlight_test.dart::高光类型优先级"
 },
