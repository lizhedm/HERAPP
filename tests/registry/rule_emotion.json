 {
  "id": "SYS-RULE-031",
  "title": "情绪分决定明度档，4 个区间在端点取到唯一明度",
  "req": [
   "REQ-16-19"
  ],
  "reqSection": [
   "9.4"
  ],
  "screens": [
   "E2",
   "E3"
  ],
  "layer": "rule",
  "priority": "P0",
  "given": [
   "固定情绪类型与 0-100 的情绪分"
  ],
  "when": [
   "计算情绪着色的明度档"
  ],
  "then": [
   "76-100 为高饱和，51-75 为中高，26-50 为中低，0-25 为暗",
   "4 个区间的 8 个端点各命中唯一明度档",
   "色系由情绪类型决定，明度由情绪分决定，两者互不干扰"
  ],
  "oracle": {
   "fn": "emotion_color",
   "cases": [
    {
     "args": [
      "开心",
      100
     ],
     "expect": {
      "family": "WARM_YELLOW",
      "brightness": "VIVID"
     }
    },
    {
     "args": [
      "开心",
      76
     ],
     "expect": {
      "family": "WARM_YELLOW",
      "brightness": "VIVID"
     }
    },
    {
     "args": [
      "开心",
      75
     ],
     "expect": {
      "family": "WARM_YELLOW",
      "brightness": "MID_HIGH"
     }
    },
    {
     "args": [
      "开心",
      51
     ],
     "expect": {
      "family": "WARM_YELLOW",
      "brightness": "MID_HIGH"
     }
    },
    {
     "args": [
      "开心",
      50
     ],
     "expect": {
      "family": "WARM_YELLOW",
      "brightness": "MID_LOW"
     }
    },
    {
     "args": [
      "开心",
      26
     ],
     "expect": {
      "family": "WARM_YELLOW",
      "brightness": "MID_LOW"
     }
    },
    {
     "args": [
      "开心",
      25
     ],
     "expect": {
      "family": "WARM_YELLOW",
      "brightness": "DIM"
     }
    },
    {
     "args": [
      "开心",
      0
     ],
     "expect": {
      "family": "WARM_YELLOW",
      "brightness": "DIM"
     }
    }
   ]
  },
  "testId": "packages/ling_core/test/emotion_test.dart::情绪明度端点"
 },
 {
  "id": "SYS-RULE-032",
  "title": "待评估日期情绪着色为中性灰且不带明度",
  "req": [
   "REQ-16-19"
  ],
  "reqSection": [
   "9.3",
   "9.4"
  ],
  "screens": [
   "E2"
  ],
  "layer": "rule",
  "priority": "P0",
  "given": [
   "日期评估状态为待评估、评估中或评估失败"
  ],
  "when": [
   "计算情绪着色"
  ],
  "then": [
   "色系为中性灰",
   "明度为空，着色不依赖情绪分",
   "评估成功与待重评状态按情绪类型与情绪分正常着色"
  ],
  "oracle": {
   "fn": "emotion_color",
   "cases": [
    {
     "kwargs": {
      "emotion_type": "开心",
      "emotion_score": 80,
      "eval_status": "PENDING"
     },
     "expect": {
      "family": "NEUTRAL_GRAY",
      "brightness": null
     }
    },
    {
     "kwargs": {
      "emotion_type": "开心",
      "emotion_score": 80,
      "eval_status": "RUNNING"
     },
     "expect": {
      "family": "NEUTRAL_GRAY",
      "brightness": null
     }
    },
    {
     "kwargs": {
      "emotion_type": "开心",
      "emotion_score": 80,
      "eval_status": "FAILED"
     },
     "expect": {
      "family": "NEUTRAL_GRAY",
      "brightness": null
     }
    },
    {
     "kwargs": {
      "emotion_type": "开心",
      "emotion_score": 80,
      "eval_status": "SUCCESS"
     },
     "expect": {
      "family": "WARM_YELLOW",
      "brightness": "VIVID"
     }
    },
    {
     "kwargs": {
      "emotion_type": "开心",
      "emotion_score": 80,
      "eval_status": "STALE"
     },
     "expect": {
      "family": "WARM_YELLOW",
      "brightness": "VIVID"
     }
    }
   ]
  },
  "testId": "packages/ling_core/test/emotion_test.dart::待评估中性灰"
 },
