# --- 工具生成的本地产物 ---
# TophantAI 设计预览与审查中间产物，由工具重新生成，不入库
.tophant/
.claude/

# --- macOS ---
.DS_Store

# --- Python（构建脚本运行产物）---
__pycache__/
*.py[cod]
.venv/
venv/

# --- 本地校验工具的依赖 ---
# 改工作流 YAML 后在本机解析校验用的 npm yaml 包，属开发者本机工具，
# 与应用代码无关。GitHub 在运行流水线时自行解析 YAML，不依赖此目录。
node_modules/

# --- 本地配置与密钥 ---
# 技术方案中的后端 baseUrl / Bearer Token / AI Key 属于本地配置，
# 一旦出现对应文件，务必保持忽略状态。
config.local.*
*.local.json
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# --- 临时文件 ---
*.log
*.tmp
~$*
